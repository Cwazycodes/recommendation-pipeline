# Settings for every component, with the values for the local Compose stack.
# make install copies this file to .env, which git ignores: change .env, not
# this file. A variable set in the environment wins over the same one in .env.
# The code has no default for any host, port, topic, group or table.

# --- Kafka, as the producer, the results writer and the tools reach it -------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Viewing events in, and the events that fail validation.
KAFKA_EVENTS_TOPIC=viewing-events
KAFKA_EVENTS_DLQ_TOPIC=viewing-events-dlq
# The job's ranked lists, and the windows the writer could not store.
KAFKA_TRENDING_TOPIC=trending-results
KAFKA_WRITER_DLQ_TOPIC=trending-writer-dlq
# The results writer's consumer group, and its static member id.
KAFKA_WRITER_GROUP_ID=results-writer
KAFKA_WRITER_INSTANCE_ID=results-writer-1

# --- Flink -------------------------------------------------------------------
# REST API, for make demo and make chaos.
FLINK_REST_URL=http://localhost:8081
# Kafka as the job reaches it from inside the Compose network.
FLINK_KAFKA_BOOTSTRAP_SERVERS=kafka:29092
# The job's Kafka source group, and where checkpoints and savepoints go (the
# flink-checkpoints volume inside the Flink containers).
FLINK_SOURCE_GROUP_ID=flink-validate
FLINK_CHECKPOINT_DIR=file:///opt/flink/checkpoints

# --- DynamoDB ----------------------------------------------------------------
# DynamoDB Local in Compose. Leave it empty to use AWS itself, which then takes
# its region and credentials from the usual AWS_* variables or profile.
DYNAMODB_ENDPOINT_URL=http://localhost:8001
# make db-init creates it under this name, from infra/dynamodb/trending-table.json.
DYNAMODB_TABLE=trending
# Which list the writer stores and the API serves: the 1-hour one.
DYNAMODB_PARTITION_KEY="TRENDING#1h"

# --- Metrics -----------------------------------------------------------------
# Prometheus in Compose, which scrapes Flink, Kafka's offsets and the results
# writer; make metrics reads it. See docs/metrics.md.
METRICS_PROMETHEUS_URL=http://localhost:9090
# Where the results writer serves its metrics. Prometheus scrapes this port as
# host.docker.internal:9464 (infra/prometheus/prometheus.yml), so change both.
METRICS_WRITER_HOST=127.0.0.1
METRICS_WRITER_PORT=9464

# --- Logs --------------------------------------------------------------------
# DEBUG adds one line per event the producer delivers, with its event_id.
LOG_LEVEL=INFO
