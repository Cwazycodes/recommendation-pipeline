ARG FLINK_VERSION=1.20.1

FROM flink:${FLINK_VERSION}-scala_2.12-java17

# Re-declare after FROM so RUN instructions can access it.
ARG FLINK_VERSION

USER root

# Install Python for the PyFlink runtime.
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Flink invokes "python", so provide that executable name.
RUN ln -sf "$(command -v python3)" /usr/local/bin/python

# Keep the Python API aligned with the Flink runtime version.
RUN python3 -m pip install --no-cache-dir \
    apache-flink==${FLINK_VERSION}

# The validation job imports the event contract, which needs Pydantic.
RUN python3 -m pip install --no-cache-dir "pydantic>=2,<3"

ARG KAFKA_CONNECTOR_VERSION=3.3.0-1.20

ADD https://repo.maven.apache.org/maven2/org/apache/flink/flink-sql-connector-kafka/${KAFKA_CONNECTOR_VERSION}/flink-sql-connector-kafka-${KAFKA_CONNECTOR_VERSION}.jar \
    /opt/flink/lib/flink-sql-connector-kafka-${KAFKA_CONNECTOR_VERSION}.jar

RUN chmod 0644 /opt/flink/lib/flink-sql-connector-kafka-3.3.0-1.20.jar

# Pre-create the checkpoint dir so the named volume inherits flink ownership.
RUN mkdir -p /opt/flink/checkpoints && chown flink:flink /opt/flink/checkpoints

USER flink
